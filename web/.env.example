# Tile server base URL. Defaults to the production server so the app works
# out of the box for new contributors. Used for basemap and black-marble
# raster tiles, which are not served by local Tegola.
VITE_TILE_BASE_URL=https://openinframap.org

# Optional: your own basemap tile server, as a full {z}/{x}/{y} URL template.
# Tiles must use the Protomaps basemap schema (https://docs.protomaps.com/basemaps/layers),
# e.g. a region extracted with `pmtiles extract` and served with `pmtiles serve`.
# Defaults to the openinframap.org basemap.
# VITE_BASEMAP_URL=http://localhost:8080/europe/{z}/{x}/{y}.mvt

# Local Tegola URL. When set, OIM infrastructure tile requests (power,
# petroleum, telecoms, water, etc.) go directly to Tegola at /maps/*.
# Tegola serves Access-Control-Allow-Origin: * so cross-origin fetches work.
# Requires: docker compose up tegola (and a completed imposm import).
# VITE_TEGOLA_URL=http://localhost:7800

# Web-backend base URL. Defaults to the production server.
# Override this to point at a local `uv run uvicorn src.main:app --reload`
# instance (see web-backend/).
VITE_BACKEND_BASE_URL=https://openinframap.org
